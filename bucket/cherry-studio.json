            "hash": "9bc72d13dfaf0530f3a3ca85d987a11bdf2cab77f819867d58bb88599265eeaa"
        },
        "arm64": {
            "url": "https://github.com/CherryHQ/cherry-studio/releases/download/v2.0.9/Cherry-Studio-2.0.9-arm64-portable.exe#/cherry-studio.exe",
